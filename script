function sort_panier(panier){
  for(let i=0; i<panier.length; i++){
      let quantite = 1
    for(let j=0; j<panier.lengh-1; i++){
      if(i === j){
        quantite = quantite
      }
      else if(panier[i] === panier[j]){
        quantite+=1
        panier.splice(j,j)
      }
    }
    console.log(quantite)
  }
  console.log(panier)
  console.log(quantite)
}


